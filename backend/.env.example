# ─────────────────────────────────────────────────────────── Banco de dados
# PostgreSQL em produção. No Supabase, prefira o **pooler em modo transação**
# (porta 6543) — a aplicação já se ajusta sozinha a ele.
T360_DATABASE_URL=postgresql+psycopg://terceiro360:senha@localhost:5432/terceiro360

# Supabase (região São Paulo). A senha vai codificada para URL se tiver
# caractere especial — um "@" na senha quebra a string de conexão em silêncio.
# T360_DATABASE_URL=postgresql+psycopg://postgres.SEUPROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Em desenvolvimento e testes o SQLite também funciona:
# T360_DATABASE_URL=sqlite+pysqlite:///./terceiro360.db

# ───────────────────────────────────────────────────────────────── Segurança
# Assina os tokens de sessão. Em produção o sistema SE RECUSA A SUBIR com o
# valor abaixo. Gere a sua:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
T360_SECRET_KEY=troque-esta-chave-em-producao

# Cifra CPF e RG em repouso. Também obrigatória em produção — e, ao contrário
# da de sessão, PERDÊ-LA TORNA OS DADOS JÁ GRAVADOS IRRECUPERÁVEIS.
# Guarde-a em cofre, não só na variável de ambiente do provedor.
T360_CHAVE_DADOS=troque-esta-chave-em-producao

T360_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origens autorizadas a chamar a API pelo navegador. Em produção, o domínio do
# painel. Nunca "*": com credenciais, qualquer site agiria como o usuário.
T360_CORS_ORIGENS=["http://localhost:3000","http://127.0.0.1:3000"]

# Teto de requisições por IP por minuto (o login tem freio próprio, menor).
T360_LIMITE_REQUISICOES_MINUTO=300

# ─────────────────────────────────────────────────────────────── Ambiente
# Em "production" o sistema exige as chaves acima, desliga /docs e envia HSTS.
T360_ENVIRONMENT=development
T360_DEBUG=true
T360_STORAGE_DIR=./storage

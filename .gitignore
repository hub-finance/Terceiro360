# Scripts de verificação no navegador, escritos e descartados a cada etapa.
# Não use "frontend/*.mjs": esse padrão engole o postcss.config.mjs, e sem ele
# o Tailwind não roda — a aplicação inteira sai sem estilo e nada no build acusa.
frontend/verifica*.mjs
frontend/fluxo*.mjs
